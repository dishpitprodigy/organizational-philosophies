# Installed as /etc/nginx/conf.d/work-intake.conf by install-local-https.sh.
# nginx terminates TLS; the Backstage development processes remain loopback-only.

map $http_upgrade $work_intake_connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name "";

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name __PUBLIC_IP__ localhost;

    ssl_certificate /etc/pki/nginx/work-intake/server.crt;
    ssl_certificate_key /etc/pki/nginx/work-intake/private/server.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:WORK_INTAKE_SSL:10m;
    ssl_session_timeout 1d;

    # Backstage's public backend URL shares the browser origin. Keeping /api on
    # the same TLS endpoint avoids a second certificate exception and CORS hop.
    location /api/ {
        proxy_pass http://127.0.0.1:7007;
        proxy_http_version 1.1;
        proxy_set_header Host localhost:7007;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $work_intake_connection_upgrade;
        proxy_read_timeout 3600s;
        proxy_buffering off;
        add_header Cache-Control "no-store" always;
    }

    # The static intake files are symlinked from the decision-tree prototype.
    # Never cache them while this remains a live-development demonstration.
    location /work-intake-assets/ {
        proxy_pass https://127.0.0.1:3000;
        proxy_ssl_verify off;
        proxy_http_version 1.1;
        proxy_set_header Host localhost:3000;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        add_header Cache-Control "no-store" always;
    }

    location / {
        proxy_pass https://127.0.0.1:3000;
        proxy_ssl_verify off;
        proxy_http_version 1.1;
        proxy_set_header Host localhost:3000;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $work_intake_connection_upgrade;
        proxy_read_timeout 3600s;
        proxy_buffering off;
        add_header Cache-Control "no-store" always;
    }
}
